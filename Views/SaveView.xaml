<UserControl x:Class="SteamLuaManager.Views.SaveView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" Padding="0,0,16,0">
            <StackPanel Margin="4,8,4,24" MaxWidth="900" HorizontalAlignment="Left">

                <!-- 顶部状态 -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Margin="2,0,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                <!-- ========== Steam 云存档（CloudRedirect，置顶） ========== -->
                <Border CornerRadius="14" Padding="24" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Steam 云存档（CloudRedirect）" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="12.5" Margin="0,0,0,14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="让“假入库 / lua 游戏”也能用上 Steam 云存档。支持 "/>
                            <Run Text="Steam 创意工坊" FontWeight="SemiBold"/>
                            <Run Text="（存档存到 Valve 创意工坊服务器、绑定你自己的 Steam 账号，无需第三方网盘登录）、Google Drive、OneDrive、S3 或本地文件夹。"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="下载 CloudRedirect（含创意工坊）" Padding="16,9" FontSize="13" FontWeight="SemiBold"
                                    Margin="0,0,10,0"
                                    IsEnabled="{Binding IsCloudRedirectDownloading, Converter={StaticResource BoolInvertConverter}}"
                                    Command="{Binding DownloadCloudRedirectCommand}"/>
                            <Button Content="启动 CloudRedirect" Padding="16,9" FontSize="13"
                                    Margin="0,0,10,0"
                                    Command="{Binding LaunchCloudRedirectCommand}"/>
                            <Button Content="项目发布页" Padding="14,9" FontSize="12.5"
                                    Command="{Binding OpenCloudRedirectPageCommand}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <ProgressBar Width="280" Height="6" HorizontalAlignment="Left"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding CloudRedirectDownloadProgress}"
                                         Visibility="{Binding IsCloudRedirectDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding CloudRedirectStatus}" FontSize="12.5" Margin="0,6,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Border CornerRadius="8" Padding="12,10"
                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="说明：&#x0a;"/>
                                <Run Text="• 下载的是作者分支版（pvzcxw/1.0.2），已包含「Steam 创意工坊」提供商，带哈希校验&#x0a;"/>
                                <Run Text="• 创意工坊方式：存档以不公开物品发布到 SpaceWar(480) 创意工坊，换电脑登录同一账号自动找回&#x0a;"/>
                                <Run Text="• 属于实验性工具，建议搭配下方「云端备份（WebDAV）」作为保险&#x0a;"/>
                                <Run Text="• 配置完成后需重启 Steam 生效；建议配套使用作者分支内核 ost1.4.9（设置→接口设置→内核更新源）" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ========== 云端备份（WebDAV） ========== -->
                <Border CornerRadius="14" Padding="24" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="云端备份（WebDAV）" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="使用 WebDAV 协议（推荐坚果云：https://dav.jianguoyun.com/dav/，需使用应用密码）"
                                   FontSize="12.5" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Text="选择游戏" FontSize="12" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding SaveGames}" SelectedItem="{Binding SelectedSave}"
                                      MinWidth="420" MaxWidth="620" Padding="12,8"
                                      HorizontalAlignment="Left">
                                <ComboBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.5"/>
                                </ComboBox.Background>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding InfoText}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="刷新列表" Margin="12,0,0,0" Padding="14,8" FontSize="12.5"
                                    VerticalAlignment="Center"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>

                        <TextBlock Text="Steam 账号" FontSize="12" Margin="0,12,0,6"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                  MinWidth="280" MaxWidth="420" Padding="10,7"
                                  HorizontalAlignment="Left">
                            <ComboBox.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.5"/>
                            </ComboBox.Background>
                        </ComboBox>

                        <TextBlock Text="{Binding SelectedSave.InfoText, StringFormat=存档信息：{0}}"
                                   FontSize="12.5" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                            <TextBlock Text="自定义存档目录" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <Button Content="添加目录" Margin="12,0,0,0" Padding="12,5" FontSize="12"
                                    VerticalAlignment="Center"
                                    Command="{Binding AddCustomFolderCommand}"/>
                        </StackPanel>
                        <TextBlock Text="用于存档不在 Steam userdata 里的游戏（如 Documents / AppData 下的存档文件夹）"
                                   FontSize="11" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding SelectedSaveCustomFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="移除" Padding="10,3" FontSize="11"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.RemoveCustomFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="存档位置扫描助手" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Button Content="扫描常见位置" Margin="12,0,0,0" Padding="12,6" FontSize="12"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding IsScanningSaveLocations, Converter={StaticResource BoolInvertConverter}}"
                                            Command="{Binding ScanSaveLocationsCommand}"/>
                                    <ui:ProgressRing IsActive="True" Width="14" Height="14" Margin="10,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsScanningSaveLocations, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBlock Text="自动扫描 Documents / My Games / Saved Games / AppData 等常见位置，找出像存档的目录后一键绑定到当前游戏"
                                           FontSize="11" Margin="0,4,0,6"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SaveScanStatus}" FontSize="11.5" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <ListBox ItemsSource="{Binding SaveCandidates}"
                                         SelectedItem="{Binding SelectedSaveCandidate}"
                                         MaxHeight="150" MinHeight="60"
                                         Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding InfoText}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="AppID" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBox Text="{Binding BindAppId, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120" Margin="8,0,0,0" Padding="8,5" FontSize="12"
                                             ToolTip="游戏不在列表里？填它的 AppID（lua 文件名就是 AppID）"/>
                                    <Button Content="绑定存档目录到游戏" Padding="14,7" FontSize="12" FontWeight="SemiBold"
                                            Margin="10,0,0,0"
                                            Command="{Binding BindSaveCandidateCommand}"/>
                                </StackPanel>
                                <TextBlock Text="已选中列表中的游戏时可不填 AppID，直接绑定到它；假入库游戏不在列表时，填 lua 文件名那个数字即可"
                                           FontSize="11" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SelectedSave.AccountName, StringFormat=Steam 账号：{0}}"
                                   FontSize="12.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="WebDAV 地址" FontSize="12" Margin="0,0,0,5"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBox Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" FontSize="13"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="账号" FontSize="12" Margin="0,0,0,5"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBox Text="{Binding WebDavUser, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="10,8" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="密码（应用密码）" FontSize="12" Margin="0,0,0,5"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <PasswordBox x:Name="WebDavPasswordBox"
                                                     PasswordChanged="WebDavPasswordBox_PasswordChanged"
                                                     Padding="10,8" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <Button Content="保存配置" Padding="14,8" FontSize="12.5" Margin="0,0,0,8"
                                        Command="{Binding SaveCloudSettingsCommand}"/>
                                <Button Content="上传当前存档" Padding="14,9" FontSize="13" FontWeight="SemiBold"
                                        Margin="0,0,0,8"
                                        Command="{Binding UploadCloudCommand}"/>
                                <Button Content="刷新云端列表" Padding="14,8" FontSize="12.5"
                                        Command="{Binding RefreshCloudCommand}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="云端备份列表" FontSize="12" Margin="0,16,0,6"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ListBox ItemsSource="{Binding CloudBackups}"
                                 SelectedItem="{Binding SelectedCloudBackup}"
                                 MaxHeight="160" MinHeight="64"
                                 Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Margin="4,3"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Content="下载并恢复所选云端备份" Padding="18,9" FontSize="13" FontWeight="SemiBold"
                                Margin="0,12,0,0" HorizontalAlignment="Left"
                                Command="{Binding RestoreCloudCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 忙碌遮罩 -->
        <Border Panel.ZIndex="50" Background="#73000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="36" Height="36" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding BusyText}" FontSize="14" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
