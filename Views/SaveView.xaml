<UserControl x:Class="SteamLuaManager.Views.SaveView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" Padding="0,0,16,0">
            <StackPanel Margin="4,8,4,24" MaxWidth="900" HorizontalAlignment="Left">

                <!-- 顶部状态 -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Margin="2,0,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                <!-- ========== 本地存档 ========== -->
                <Border CornerRadius="14" Padding="24" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="本地存档" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Button Content="刷新列表" Margin="16,0,0,0" Padding="14,6" FontSize="12.5"
                                    VerticalAlignment="Center"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                        <TextBlock Text="自动扫描 Steam userdata 目录中的本地云存档（remote 文件夹）"
                                   FontSize="12.5" Margin="0,4,0,16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Text="选择游戏" FontSize="12" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ComboBox ItemsSource="{Binding SaveGames}" SelectedItem="{Binding SelectedSave}"
                                  MinWidth="420" MaxWidth="620" Padding="12,8"
                                  HorizontalAlignment="Left">
                            <ComboBox.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.5"/>
                            </ComboBox.Background>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding InfoText}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding SelectedSave.InfoText, StringFormat=存档信息：{0}}"
                                   FontSize="12.5" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedSave.AccountName, StringFormat=Steam 账号：{0}}"
                                   FontSize="12.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="打开存档目录" Padding="18,9" FontSize="13" Margin="0,0,10,0"
                                    Command="{Binding OpenSaveFolderCommand}"/>
                            <Button Content="备份到本地" Padding="18,9" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding BackupLocalCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 本地备份 ========== -->
                <Border CornerRadius="14" Padding="24" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="本地备份" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="每次备份/替换前都会自动生成一份，可随时一键恢复"
                                   FontSize="12.5" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <ListBox ItemsSource="{Binding LocalBackups}"
                                 SelectedItem="{Binding SelectedLocalBackup}"
                                 MaxHeight="180" MinHeight="72"
                                 Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Margin="4,3"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="恢复所选备份" Padding="18,9" FontSize="13" FontWeight="SemiBold"
                                    Margin="0,0,10,0"
                                    Command="{Binding RestoreLocalCommand}"/>
                            <Button Content="打开备份文件夹" Padding="14,9" FontSize="12.5"
                                    Command="{Binding OpenBackupFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 云端备份 ========== -->
                <Border CornerRadius="14" Padding="24" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="云端备份" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="使用 WebDAV 协议（推荐坚果云：https://dav.jianguoyun.com/dav/，需使用应用密码）"
                                   FontSize="12.5" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="WebDAV 地址" FontSize="12" Margin="0,0,0,5"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBox Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" FontSize="13"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="账号" FontSize="12" Margin="0,0,0,5"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBox Text="{Binding WebDavUser, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="10,8" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="密码（应用密码）" FontSize="12" Margin="0,0,0,5"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <PasswordBox x:Name="WebDavPasswordBox"
                                                     PasswordChanged="WebDavPasswordBox_PasswordChanged"
                                                     Padding="10,8" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <Button Content="保存配置" Padding="14,8" FontSize="12.5" Margin="0,0,0,8"
                                        Command="{Binding SaveCloudSettingsCommand}"/>
                                <Button Content="上传当前存档" Padding="14,9" FontSize="13" FontWeight="SemiBold"
                                        Margin="0,0,0,8"
                                        Command="{Binding UploadCloudCommand}"/>
                                <Button Content="刷新云端列表" Padding="14,8" FontSize="12.5"
                                        Command="{Binding RefreshCloudCommand}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="云端备份列表" FontSize="12" Margin="0,16,0,6"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ListBox ItemsSource="{Binding CloudBackups}"
                                 SelectedItem="{Binding SelectedCloudBackup}"
                                 MaxHeight="160" MinHeight="64"
                                 Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Margin="4,3"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Content="下载并恢复所选云端备份" Padding="18,9" FontSize="13" FontWeight="SemiBold"
                                Margin="0,12,0,0" HorizontalAlignment="Left"
                                Command="{Binding RestoreCloudCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ========== 完美存档替换 ========== -->
                <Border CornerRadius="14" Padding="24" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="完美存档一键替换" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="12.5" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="从网上下载完美存档（ZIP 或文件夹），工具会自动："/>
                            <Run Text="① 备份当前存档 → ② 替换到游戏存档目录 → ③ 修正存档内的 Steam 账号 ID" FontWeight="SemiBold"/>
                            <Run Text="。无需 Cheat Engine（CE 用于改内存，存档 ID 是直接写在存档文件里的，直接文本/二进制替换即可）。"/>
                        </TextBlock>

                        <CheckBox Content="自动替换存档内账号 ID（推荐，防止“存档不通用”）"
                                  IsChecked="{Binding ReplaceIdsEnabled}"
                                  FontSize="13" Margin="0,0,0,10"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <TextBlock Text="存档来源账号的 SteamID（64 位或 3 位均可，可留空）"
                                   FontSize="12" Margin="0,0,0,5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBox Text="{Binding OriginalSteamId, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="13" MaxWidth="420" HorizontalAlignment="Left"
                                 ToolTip="填写存档原主人的账号 ID，工具会自动换算成 64 位与 3 位两种形式并替换为本机 ID"/>

                        <TextBlock Text="自定义替换规则（每行一条：旧值=新值，可留空）"
                                   FontSize="12" Margin="0,12,0,5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBox Text="{Binding CustomRules, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="12.5" Height="64" MaxWidth="560"
                                 HorizontalAlignment="Left" AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ToolTip="示例：\n1234567890=76561198012345678\n保存数据=存档数据"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="导入存档 ZIP" Padding="18,9" FontSize="13" FontWeight="SemiBold"
                                    Margin="0,0,10,0"
                                    Command="{Binding ImportPerfectSaveCommand}"/>
                            <Button Content="导入存档文件夹" Padding="18,9" FontSize="13" FontWeight="SemiBold"
                                    Margin="0,0,10,0"
                                    Command="{Binding ImportPerfectSaveFolderCommand}"/>
                            <Button Content="搜索完美存档" Padding="14,9" FontSize="12.5"
                                    Command="{Binding SearchPerfectSaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 忙碌遮罩 -->
        <Border Panel.ZIndex="50" Background="#73000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="36" Height="36" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding BusyText}" FontSize="14" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
