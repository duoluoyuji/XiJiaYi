<UserControl x:Class="SteamLuaManager.Views.TrainerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" Padding="0,0,16,0">
            <StackPanel Margin="4,8,4,24" MaxWidth="1040" HorizontalAlignment="Left">

                <!-- 搜索栏 -->
                <Border CornerRadius="14" Padding="20,16" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="搜索修改器（支持中英文游戏名）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="420" MaxWidth="620" Padding="12,9" FontSize="13"
                                     KeyDown="SearchBox_KeyDown">
                                <TextBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.5"/>
                                </TextBox.Background>
                            </TextBox>
                            <Button Content="搜索" Padding="22,9" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                                    IsEnabled="{Binding IsSearching, Converter={StaticResource BoolInvertConverter}}"
                                    Command="{Binding SearchCommand}"/>
                            <ui:ProgressRing IsActive="True" Width="18" Height="18" Margin="12,0,0,0"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 分类切换 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="热门推荐" Padding="16,8" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                            Command="{Binding ShowSectionCommand}" CommandParameter="hot"/>
                    <Button Content="最新发布" Padding="16,8" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                            Command="{Binding ShowSectionCommand}" CommandParameter="new"/>
                    <Button Content="搜索结果" Padding="16,8" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                            Command="{Binding ShowSectionCommand}" CommandParameter="search"/>
                    <Button Content="已下载" Padding="16,8" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                            Command="{Binding ShowSectionCommand}" CommandParameter="downloaded"/>
                    <Button Content="打开修改器文件夹" Padding="14,8" FontSize="12"
                            Command="{Binding OpenTrainerFolderCommand}"/>
                    <Button Content="刷新列表" Padding="14,8" FontSize="12"
                            IsEnabled="{Binding IsSearching, Converter={StaticResource BoolInvertConverter}}"
                            Command="{Binding LoadSectionsCommand}"/>
                </StackPanel>

                <!-- 热门推荐 -->
                <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=hot}">
                    <ItemsControl ItemsSource="{Binding HotTrainers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="224" Margin="0,0,12,12" CornerRadius="12" Padding="12"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <StackPanel>
                                        <Border Height="86" CornerRadius="8" ClipToBounds="True" Background="#1AFFFFFF">
                                            <controls:AsyncImage SourceUrl="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="40"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding UpdateDate}" FontSize="11" Margin="0,2,0,8"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="打开修改器" Padding="10,6" FontSize="12" FontWeight="SemiBold"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.LaunchTrainerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="下载修改器" Padding="10,6" FontSize="12" FontWeight="SemiBold"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <ProgressBar Height="4" Margin="0,6,0,0"
                                                     Value="{Binding DownloadProgress}" Maximum="100"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 最新发布 -->
                <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=new}">
                    <ItemsControl ItemsSource="{Binding NewTrainers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="224" Margin="0,0,12,12" CornerRadius="12" Padding="12"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <StackPanel>
                                        <Border Height="86" CornerRadius="8" ClipToBounds="True" Background="#1AFFFFFF">
                                            <controls:AsyncImage SourceUrl="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="40"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding UpdateDate}" FontSize="11" Margin="0,2,0,8"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="打开修改器" Padding="10,6" FontSize="12" FontWeight="SemiBold"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.LaunchTrainerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="下载修改器" Padding="10,6" FontSize="12" FontWeight="SemiBold"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <ProgressBar Height="4" Margin="0,6,0,0"
                                                     Value="{Binding DownloadProgress}" Maximum="100"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 搜索结果 -->
                <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=search}">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="224" Margin="0,0,12,12" CornerRadius="12" Padding="12"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <StackPanel>
                                        <Border Height="86" CornerRadius="8" ClipToBounds="True" Background="#1AFFFFFF">
                                            <controls:AsyncImage SourceUrl="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="40"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding UpdateDate}" FontSize="11" Margin="0,2,0,8"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="打开修改器" Padding="10,6" FontSize="12" FontWeight="SemiBold"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.LaunchTrainerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="下载修改器" Visibility="{Binding IsDownloaded, Converter={StaticResource InvertedBoolToVisibilityConverter}}" Padding="10,6" FontSize="12" FontWeight="SemiBold"
                                                    Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="详情页" Padding="10,6" FontSize="12" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.OpenTrainerPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <ProgressBar Height="4" Margin="0,6,0,0"
                                                     Value="{Binding DownloadProgress}" Maximum="100"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 已下载 -->
                <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=downloaded}">
                    <ItemsControl ItemsSource="{Binding DownloadedTrainers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" CornerRadius="10" Padding="14,10"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding LocalPath}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="打开修改器" Padding="12,7" FontSize="12" FontWeight="SemiBold"
                                                    Command="{Binding DataContext.LaunchTrainerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- 忙碌遮罩 -->
        <Border Panel.ZIndex="50" Background="#73000000"
                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="34" Height="34" HorizontalAlignment="Center"/>
                <TextBlock Text="正在获取修改器信息..." FontSize="13" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
