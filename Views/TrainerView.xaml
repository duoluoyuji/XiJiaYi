<UserControl x:Class="SteamLuaManager.Views.TrainerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent" Padding="0,0,16,0">
        <StackPanel Margin="4,8,4,24" MaxWidth="900" HorizontalAlignment="Left">

            <Border CornerRadius="14" Padding="24" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="修改器（Game-Cheats-Manager）" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="12.5" Margin="0,0,0,14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="基于开源项目 "/>
                        <Run Text="Game-Cheats-Manager" FontWeight="SemiBold"/>
                        <Run Text="（dyang886）重新实现，支持 "/>
                        <Run Text="中英文搜索" FontWeight="SemiBold"/>
                        <Run Text="修改器、热门推荐、最新发布、下载管理与 Cheat Engine 集成。"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="下载最新版" Padding="16,9" FontSize="13" FontWeight="SemiBold"
                                Margin="0,0,10,0"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource BoolInvertConverter}}"
                                Command="{Binding DownloadCommand}"/>
                        <Button Content="启动 Game-Cheats-Manager" Padding="16,9" FontSize="13"
                                Margin="0,0,10,0"
                                Command="{Binding LaunchCommand}"/>
                        <Button Content="项目发布页" Padding="14,9" FontSize="12.5"
                                Command="{Binding OpenProjectPageCommand}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <ProgressBar Width="320" Height="6" HorizontalAlignment="Left"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding DownloadProgress}"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border CornerRadius="8" Padding="12,10"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="说明：&#x0a;"/>
                            <Run Text="• 下载的是作者官方免安装版，来源为官方 GitHub 发布页&#x0a;"/>
                            <Run Text="• 搜索、热门推荐、最新发布等数据由 GCM 自身的在线数据源提供&#x0a;"/>
                            <Run Text="• 支持中英文搜索修改器，可下载管理、自动关联 Cheat Engine（CE）&#x0a;"/>
                            <Run Text="• 本项目基于 GPL-3.0 开源的 Game-Cheats-Manager，详情见其项目主页" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>