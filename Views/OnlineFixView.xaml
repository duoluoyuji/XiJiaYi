<UserControl x:Class="SteamLuaManager.Views.OnlineFixView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent" Padding="0,0,16,0">
        <StackPanel Margin="4,8,4,24" MaxWidth="860" HorizontalAlignment="Left">

            <!-- 启动卡片 -->
            <Border CornerRadius="14" Padding="24" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="启动游戏并联机" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="选择已入库的游戏，以 SpaceWar(480) 身份启动，与好友一起在线游玩"
                               FontSize="12.5" Margin="0,4,0,16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Text="选择游戏" FontSize="12" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGameForOnlineFix}"
                              MinWidth="360" MaxWidth="520" Padding="12,8"
                              HorizontalAlignment="Left">
                        <ComboBox.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.5"/>
                        </ComboBox.Background>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding GameName}" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding AppId, StringFormat=' (AppID {0})'}" FontSize="12"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Command="{Binding LaunchOnlineFixCommand}" Content="启动游戏联机"
                            Padding="20,10" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,0"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- 功能说明 -->
            <Border CornerRadius="14" Padding="24" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.5"/>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="这是什么" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="这是 SpaceWar(480) 联机：OpenSteamTool 内核通过启动参数 "/>
                        <Run Text="-onlinefix" FontFamily="Consolas" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                        <Run Text="（内核内部就叫 OnlineFix，与 online-fix.me 网站/补丁无关）把游戏的 AppID 临时替换为 480（SpaceWar），"/>
                        <Run Text="游戏联机请求走 SpaceWar 的大厅匹配通道，从而与好友联机。"/>
                    </TextBlock>

                    <TextBlock Text="使用步骤" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="24" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="1. 在上方选择已入库的游戏（Lua 清单已配置）&#x0a;"/>
                        <Run Text="2. 点击“启动游戏联机”&#x0a;"/>
                        <Run Text="3. 工具会自动执行："/> 
                        <Run Text="steam.exe -applaunch &lt;AppID&gt; -onlinefix" FontFamily="Consolas"
                             Foreground="{DynamicResource SystemAccentColorBrush}"/>
                        <Run Text="&#x0a;4. 好友也需使用同样的方式启动，双方进入游戏后通过大厅匹配联机&#x0a;"/>
                        <Run Text="5. 说明：此功能不下载、不安装 online-fix.me 等联机补丁，也不修改游戏文件"/>
                    </TextBlock>

                    <TextBlock Text="使用限制" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="24" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="• 仅支持使用大厅匹配（Lobby）进行联机的游戏&#x0a;"/>
                        <Run Text="• 同一时间只能运行一个使用此功能的游戏&#x0a;"/>
                        <Run Text="• 双方游戏版本需一致，且都已安装 OpenSteamTool 内核&#x0a;"/>
                        <Run Text="• 游戏必须已在 Lua 清单中配置（已入库）&#x0a;"/>
                        <Run Text="• 好友列表里会显示你在玩 SpaceWar；需要登录厂商服务器的游戏此功能无效"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
