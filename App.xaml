<Application x:Class="SteamLuaManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:primitives="clr-namespace:iNKORE.UI.WPF.Modern.Controls.Primitives;assembly=iNKORE.UI.WPF.Modern"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Dark" AccentColor="#FF8F6BFF"/>
                <ui:XamlControlsResources/>
                <ResourceDictionary Source="Converters/ValueConverters.xaml"/>
                <ResourceDictionary Source="Skins/PureBlack.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <!-- 标题栏图标（矢量绘制，不依赖字体，任何系统都能正常显示） -->
            <PathGeometry x:Key="IconMinimize" Figures="M0.5,6 L11.5,6"/>
            <PathGeometry x:Key="IconMaximize" Figures="M0.5,0.5 L11.5,0.5 L11.5,11.5 L0.5,11.5 Z"/>
            <PathGeometry x:Key="IconRestore" Figures="M0.5,3.5 L0.5,11.5 L8.5,11.5 M0.5,3.5 L8.5,3.5 L8.5,11.5 M3.5,0.5 L11.5,0.5 L11.5,8.5"/>
            <PathGeometry x:Key="IconClose" Figures="M0.5,0.5 L11.5,11.5 M11.5,0.5 L0.5,11.5"/>

            <!-- 标题栏按钮：最小化/最大化 -->
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 标题栏按钮：关闭（悬停红色） -->
            <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#F1707A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 透明标题栏模板：无图标、无标题文字，只保留右上角窗口按钮，背景与内容完全融合 -->
            <Style x:Key="CustomTitleBarStyle" TargetType="primitives:TitleBarControl">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:TitleBarControl">
                            <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="PART_LeftSystemOverlay" Orientation="Horizontal"/>
                                <StackPanel x:Name="PART_RightSystemOverlay" Grid.Column="2" Orientation="Horizontal">

                                    <Button x:Name="MinimizeButton"
                                            Width="46" Height="{TemplateBinding Height}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Style="{StaticResource CaptionButtonStyle}"
                                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                            ToolTip="最小化"
                                            AutomationProperties.Name="最小化">
                                        <Path Data="{StaticResource IconMinimize}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              StrokeThickness="1.3" Width="12" Height="12" Stretch="None"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Button>

                                    <Button x:Name="MaximizeRestoreButton"
                                            Width="46" Height="{TemplateBinding Height}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Style="{StaticResource CaptionButtonStyle}"
                                            Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                            ToolTip="最大化"
                                            AutomationProperties.Name="最大化">
                                        <Grid Width="12" Height="12">
                                            <Path x:Name="MaxIcon"
                                                  Data="{StaticResource IconMaximize}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  StrokeThickness="1.3" Stretch="None"/>
                                            <Path x:Name="RestoreIcon"
                                                  Data="{StaticResource IconRestore}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  StrokeThickness="1.3" Stretch="None" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="CloseButton"
                                            Width="46" Height="{TemplateBinding Height}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Style="{StaticResource CaptionCloseButtonStyle}"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                                            ToolTip="关闭"
                                            AutomationProperties.Name="关闭">
                                        <Path Data="{StaticResource IconClose}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              StrokeThickness="1.3" Width="12" Height="12" Stretch="None"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Button>

                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                    <Setter TargetName="MaxIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="RestoreIcon" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="MaximizeRestoreButton" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
                                    <Setter TargetName="MaximizeRestoreButton" Property="ToolTip" Value="还原"/>
                                    <Setter TargetName="MaximizeRestoreButton" Property="AutomationProperties.Name" Value="还原"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
